<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <!-- C1 -->
    <TextView
        android:id="@+id/C1_text"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/button_bg_selector"
        android:text="C1"
        android:gravity="center"
        android:textSize="36sp"
        android:textColor="@drawable/button_txt_selector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- C6 -->
    <TextView
        android:id="@+id/C6_text"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/button_bg_selector"
        android:text="C6"
        android:gravity="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- C3 -->
    <TextView
        android:id="@+id/C3_text"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginStart="82dp"
        android:layout_marginBottom="395dp"
        android:background="@drawable/button_bg_selector"
        android:text="C3"
        android:gravity="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- C8 -->
    <TextView
        android:id="@+id/C8_text"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="395dp"
        android:background="@drawable/button_bg_selector"
        android:text="C8"
        android:gravity="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--    result output-->

    <!--    result output-->
    <TextView
        android:id="@+id/result_text"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="284dp"
        android:background="@drawable/border"
        android:gravity="center"
        android:text="Result state"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/detect_btn"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:layout_marginStart="190dp"
        android:layout_marginBottom="84dp"
        android:text="Detect"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/switch_btn"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="84dp"
        android:text="Switch"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/mode_status_txt"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="184dp"
        android:background="@drawable/border"
        android:gravity="center"
        android:text="Detect Mode"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Detect button  -->

    <!-- mode switch button -->


</androidx.constraintlayout.widget.ConstraintLayout>

