<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- C1 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/C1_btn"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="75dp"
        android:background="@drawable/button_bg_selector"
        android:text="C1"
        android:textAlignment="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- C6 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/C6_btn"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/button_bg_selector"
        android:text="C6"
        android:textAlignment="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- C3 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/C3_btn"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginStart="82dp"
        android:layout_marginBottom="400dp"
        android:background="@drawable/button_bg_selector"
        android:text="C3"
        android:textAlignment="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- C8  -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/C8_btn"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="400dp"
        android:background="@drawable/button_bg_selector"
        android:text="C8"
        android:textAlignment="center"
        android:textColor="@drawable/button_txt_selector"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Spinner
        android:id="@+id/activity_spinner"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="332dp"
        android:entries="@array/activity_states"
        android:theme="@style/spinner_style"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/mode_status_txt"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="252dp"
        android:background="@drawable/border"
        android:gravity="center"
        android:text="Train Mode"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/switch_btn"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:text="Switch"
        android:textSize="20sp"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- detect button -->
    <Button
        android:id="@+id/train_wifi_btn"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:text="Train Location"
        android:textSize="16sp"
        android:layout_marginLeft="200dp"
        android:layout_marginBottom = "160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/train_acc_btn"
        android:layout_width="130dp"
        android:layout_height="80dp"
        android:text="Train Activity"
        android:textSize="16sp"
        android:layout_marginLeft="200dp"
        android:layout_marginBottom = "60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

